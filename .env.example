# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# Optional app port
PORT=3001

# Optional database provider: d1 (default) or postgres
DATABASE_PROVIDER=d1

# If using postgres:
# POSTGRES_URL=postgresql://user:password@localhost:5432/saas_db

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - hosted: Better Auth email/password, social login, organizations & invitations
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
# - cloudflare_access: validate Cloudflare Access JWTs (for private team deployments)
#
AUTH_MODE=hosted

# Required when AUTH_MODE=hosted
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001

# Optional Social OAuth (Google)
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# -----------------------------------------------------------------------------
# AI Agent & Streaming (OpenRouter)
# -----------------------------------------------------------------------------
# Required for SAM chat agent (Cloudflare Agents DO)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# -----------------------------------------------------------------------------
# Billing (Autumn) - Optional
# -----------------------------------------------------------------------------
# AUTUMN_SECRET_KEY=
# AUTUMN_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Analytics & Email - Optional
# -----------------------------------------------------------------------------
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=
# LOOPS_TRANSACTIONAL_INVITATION_ID=
